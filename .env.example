# Configuración del servidor
PORT=4173
NODE_ENV=development

# Ruta de la base de datos SQLite (fuera del repositorio público)
LICENSE_DB_PATH=/var/lib/metodo-judicial/licenses.sqlite3

# Ruta del panel administrativo (la seguridad real reside en la sesión y el rol del servidor)
ADMIN_PANEL_PATH=/panel-licencias

# Secreto HMAC para firmar credenciales de instalación (generar con: openssl rand -hex 32)
INSTALLATION_TOKEN_SECRET=reemplazar_por_valor_aleatorio_seguro_de_64_caracteres_hex_000000

# Nombres de cookies
ADMIN_SESSION_COOKIE=mj_admin_session
INSTALLATION_COOKIE=mj_installation_cred
